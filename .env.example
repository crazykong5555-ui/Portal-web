# Copy the MySQL connection values from your Aiven service's Connection
# information page. Do not commit the populated .env file.
MYSQL_HOST=mysql-your-service.a.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=change-me
MYSQL_DB=defaultdb
# Optional but recommended: path to the CA certificate downloaded from Aiven.
# MYSQL_SSL_CA=./ca.pem
