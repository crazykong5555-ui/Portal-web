# Do not commit populated secrets. Use your hosting provider's secret settings in production.
APP_ENV=production
SECRET_KEY=generate-a-long-random-value
APP_USERNAME=change-me
APP_PASSWORD=change-me
MYSQL_HOST=mysql-your-service.a.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=change-me
MYSQL_DB=defaultdb
MYSQL_SSL=required
# Mount the Aiven CA certificate as ca/aiven-ca.pem in the deployment image.
MYSQL_SSL_CA=ca/aiven-ca.pem
PORT=8000
